        "operation": "update",
        "old_hash": "3c7b5f1d2a7e4cb68f4b33d20c342f87df8af3f8f0dcbcb3552f7c8f35ea1887",
        "new_hash": "bef4b0b23bc6e4fcbf64cfd9d3405fceea27191c0b37db114d4e62ebccb8eaf7",
        "ttl_seconds": 3600
      },
      "error_scenarios": [
        {
          "code": "ERR_GUARDRAIL_VIOLATION",
          "when": "The target path is outside approved writable patterns.",
          "example_response": {
            "code": "ERR_GUARDRAIL_VIOLATION",
            "message": "The requested file operation violates configured guardrails.",
            "details": { "file_path": "../../outside.md" }
          }
        },
        {
          "code": "ERR_INTERNAL",
          "when": "Unexpected proposal-store write failure.",
          "example_response": {
            "code": "ERR_INTERNAL",
            "message": "The server encountered an unexpected internal error.",
            "details": {
              "operation": "propose_memory_update",
              "cause": "failed to insert proposal row"
            }
          }
        }
      ]
    },
    {
      "name": "list_proposals",
      "request_schema": "src/obsidian_memory_mcp/schemas/list_proposals.json#/request",
      "response_schema": "src/obsidian_memory_mcp/schemas/list_proposals.json#/response",
      "example_request": {
        "project": "occlave",
