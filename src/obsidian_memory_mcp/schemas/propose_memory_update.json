{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "tool": "propose_memory_update",
  "request": {
    "type": "object",
    "additionalProperties": false,
    "required": ["project", "file_path", "operation"],
    "properties": {
      "project": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "file_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "operation": { "type": "string", "enum": ["create", "update", "delete"] },
      "content": { "type": "string" }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "operation": { "enum": ["create", "update"] }
          }
        },
        "then": {
          "required": ["content"]
        }
      }
    ]
  },
  "response": {
    "type": "object",
    "additionalProperties": false,
    "required": ["project", "proposal_id", "file_path", "operation", "old_hash", "new_hash", "ttl_seconds"],
    "properties": {
      "project": { "type": "string", "minLength": 1 },
      "proposal_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "file_path": { "type": "string", "minLength": 1 },
      "operation": { "type": "string", "enum": ["create", "update", "delete"] },
      "old_hash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "new_hash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "ttl_seconds": { "type": "integer", "minimum": 1 }
    }
  }
}